#!/bin/bash
#
# postinstall — runs as root after Installer copies GateLink.app.
#
# GateLink used to run its own VPN tunnel through a root helper. It now logs in
# through the official GlobalProtect app, so stop any tunnel the old helper
# still runs and remove the helper and its passwordless sudo rule.
#
HELPER_DIR="/usr/local/libexec/gatelink"

[[ -x "${HELPER_DIR}/gatelink-tunnel" ]] && "${HELPER_DIR}/gatelink-tunnel" stop
/bin/rm -f /etc/sudoers.d/gatelink
/bin/rm -rf "${HELPER_DIR}"
exit 0
